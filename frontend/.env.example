# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local or any file containing real secrets.

# --- App ---
NEXT_PUBLIC_APP_NAME="AI AR Manager"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Backend API ---
# Base URL of the backend service the frontend talks to.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# --- Auth / session ---
# Name of the auth cookie checked in app/(dashboard)/layout.tsx
SESSION_COOKIE_NAME=ar_session
# Secret used to sign/verify the session cookie (generate with: openssl rand -hex 32)
SESSION_SECRET=replace-with-a-random-32-byte-secret
