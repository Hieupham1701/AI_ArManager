# Copy this file to .env and fill in real values for local development.
# Never commit .env or any file containing real secrets.

# --- Server ---
PORT=8000

# --- Frontend / CORS / email redirect target ---
FRONTEND_URL=http://localhost:3000

# --- Supabase Auth (see api/auth.py) ---
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-your-supabase-anon-key
# Service Role Key (needed for automatic user profile creation during signup)
# Copy from: Project Settings -> API -> "Service Role Secret"
SERVICE_ROLE_KEY=replace-with-your-service-role-key

# --- AI / LLM provider (invoice prioritization & follow-up strategy) ---
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Email (client communications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=collections@yourcompany.com

# --- SMS / Telephony (client communications) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
