# Copy this file to .env and fill in real values for local development.
# This file is read by the BACKEND SERVER only.
# The project owner/deployer configures provider credentials once; end users
# do not edit .env when they send a message from the frontend.
# Never commit .env or any file containing real secrets.

# --- Server ---
PORT=8000

# --- Frontend / CORS / email redirect target ---
FRONTEND_URL=http://localhost:3000

# --- Supabase Auth (see api/auth.py) ---
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-your-supabase-anon-key
# Service Role Key (needed for automatic user profile creation during signup)
# Copy from: Project Settings -> API -> "Service Role Secret"
SERVICE_ROLE_KEY=replace-with-your-service-role-key

# --- AI / LLM provider (invoice prioritization & follow-up strategy) ---
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Email (client communications) ---
# Local/demo setup: use one team-owned Gmail/Google Workspace account.
# For Gmail, use an App Password (not the normal Google password), with
# 2-Step Verification enabled on that account.
# Gmail TLS uses smtp.gmail.com on port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=collections@yourcompany.com
SMTP_USE_SSL=false

# Backward-compatible aliases also accepted by the sender:
# SMTP_USER=
# EMAIL_FROM_ADDRESS=collections@yourcompany.com

# --- SMS / Telephony (client communications) ---
# Local/demo setup: create one Twilio account and one SMS-capable Twilio
# phone number. The backend uses these values for every outbound SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Backward-compatible alias also accepted by the sender:
# TWILIO_PHONE_NUMBER=
